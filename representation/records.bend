  match r:
    case TreeNode{parent, children, text}:
      TreeNode{parent, v, text}

def TreeNode.text(r: TreeNode) -> Value:
  match r:
    case TreeNode{parent, children, text}:
      text

def TreeNode.with_text(r: TreeNode, v: Value) -> TreeNode:
  match r:
    case TreeNode{parent, children, text}:
      TreeNode{parent, children, v}


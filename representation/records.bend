type Link is Data:
  Link{dep: Nat, sub: Nat, nextDep: Nat, prevSub: Nat, nextSub: Nat, gen: Nat}

def Link.dep(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      dep

def Link.with_dep(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{v, sub, nextDep, prevSub, nextSub, gen}

def Link.sub(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      sub

def Link.with_sub(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, v, nextDep, prevSub, nextSub, gen}

def Link.nextDep(r: Link) -> Nat:
  match r:

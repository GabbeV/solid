type Link is Data:
  Link{dep: Nat, sub: Nat, nextDep: Nat, prevSub: Nat, nextSub: Nat, gen: Nat}

def Link.dep(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      dep

def Link.with_dep(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{v, sub, nextDep, prevSub, nextSub, gen}

def Link.sub(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      sub

def Link.with_sub(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, v, nextDep, prevSub, nextSub, gen}

def Link.nextDep(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      nextDep

def Link.with_nextDep(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, sub, v, prevSub, nextSub, gen}

def Link.prevSub(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      prevSub

def Link.with_prevSub(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, sub, nextDep, v, nextSub, gen}

def Link.nextSub(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      nextSub

def Link.with_nextSub(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, sub, nextDep, prevSub, v, gen}

def Link.gen(r: Link) -> Nat:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      gen

def Link.with_gen(r: Link, v: Nat) -> Link:
  match r:
    case Link{dep, sub, nextDep, prevSub, nextSub, gen}:
      Link{dep, sub, nextDep, prevSub, nextSub, v}

type TreeNode is Data:

def choice(+flag: Bool,+w: R.World,+yes: R.World,+no: R.World,left: {observe(yes) == observe(w) : View},right: {observe(no) == observe(w) : View}) -> {observe(B.choose(~R.World,flag,_=>yes,_=>no)) == observe(w) : View}:
  match flag:
    case True{}: left
    case False{}: right

def schedule(+w: R.World) -> {observe(B.schedule(w)) == observe(w) : View}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      match running scheduled halted haltNotified syncDepth:
        case _ _ True{} True{} _: {==}
        case _ _ True{} False{} _: {==}
        case _ True{} False{} _ _: {==}
        case True{} False{} False{} _ 0n: {==}
        case True{} False{} False{} _ 1n+p: {==}
        case False{} False{} False{} _ 0n: {==}
        case False{} False{} False{} _ 1n+p: {==}

def selected(+w: R.World) -> {observe(Join.scheduled(w)) == observe(w) : View}:
  choice(R.World.running(w),w,w,B.schedule(w),{==},schedule(w))

def prepared(+w: R.World,+actor: Nat,+offset: Nat,+tail: R.Expr,captured: {R.ActionState.transaction(A.get(w,actor)) == 1n+offset : Nat},empty: {R.World.flushTransaction(w) == 0n : Nat},terminal: {R.Transaction.into(B.transaction(w,1n+offset)) == 0n : Nat}) -> {observe(Prepared.prepared(w,actor,tail)) == enter(observe(w)) : View}:
  +asked = Prepared.asked(w,actor)
  +joined = Prepared.joined(w,actor)
  +flushed = Source.flush(asked,1n+offset)
  +scheduled = Join.scheduled(flushed)
  +same = Equal.trans(View,observe(joined),observe(scheduled),observe(w),Equal.cong(R.World,View,state=>observe(state),joined,scheduled,Source.joined(w,actor,offset,captured,empty,terminal)),Equal.trans(View,observe(scheduled),observe(flushed),observe(w),selected(flushed),Equal.trans(View,observe(flushed),observe(asked),observe(w),future(asked,1n+offset),question(w,R.ActionState.question(A.get(w,actor))))))
  Equal.trans(View,observe(Prepared.prepared(w,actor,tail)),observe(A.enter(joined)),enter(observe(w)),store(A.enter(joined),actor,R.ActionState.with_methods(A.get(joined,actor),tail)),Equal.trans(View,observe(A.enter(joined)),enter(observe(joined)),enter(observe(w)),entered(joined),Equal.cong(View,View,v=>enter(v),observe(joined),observe(w),same)))

def fromWrites(+w: R.World,+next: R.World,+slot: Nat,same: {Writes.observe(next,slot) == Writes.observe(w,slot) : R.World}) -> {observe(next) == observe(w) : View}:
  Equal.trans(View,observe(next),observe(Writes.observe(next,slot)),observe(w),Equal.sym(View,observe(Writes.observe(next,slot)),observe(next),writeMask(next,slot)),Equal.trans(View,observe(Writes.observe(next,slot)),observe(Writes.observe(w,slot)),observe(w),Equal.cong(R.World,View,state=>observe(state),Writes.observe(next,slot),Writes.observe(w,slot),same),writeMask(w,slot)))

def fromHelpers(+w: R.World,+next: R.World,same: {Context.erase(next) == Context.erase(w) : R.World}) -> {observe(next) == observe(w) : View}:
  Equal.trans(View,observe(next),observe(Context.erase(next)),observe(w),Equal.sym(View,observe(Context.erase(next)),observe(next),helperMask(next)),Equal.trans(View,observe(Context.erase(next)),observe(Context.erase(w)),observe(w),Equal.cong(R.World,View,state=>observe(state),Context.erase(next),Context.erase(w),same),helperMask(w)))

def target(+w: R.World,+root: Nat,+remaining: Nat) -> {observe(Exit.target(w,root,remaining)) == exit(observe(w)) : View}:
  +next = A.exit(w)
  +record = R.Transaction.with_open(B.transaction(next,root),remaining)
  +stored = B.store_transaction(next,root,record)
  Equal.trans(View,observe(Exit.target(w,root,remaining)),observe(stored),exit(observe(w)),schedule(stored),Equal.trans(View,observe(stored),observe(next),exit(observe(w)),transaction(next,root,record),exited(w)))

def raw(+value: R.Value,+methods: R.Expr) -> {observe(Construct.opened(value,methods)) == Flags{0n,False{},False{}} : View}:
  {==}

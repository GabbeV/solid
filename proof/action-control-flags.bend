# Depth/running/halted observations across action preparation, supported writes,
# retirement, output masking and queued observer requests. Scheduling readiness
# is proved separately because source setters intentionally change that field.
import Base
import ../representation/records.bend as R
import ../representation/base.bend as B
import ../runtime/action-state.bend as A
import ../runtime/question.bend as Q
import ./held-setter-entry.bend as Join
import ./held-preparation-source.bend as Source
import ./action-body-entry.bend as Prepared
import ./action-body-retirement.bend as Exit
import ./action-output-frame.bend as Output
import ./held-write-outer.bend as Writes
import ./action-helper-context.bend as Context
import ./action-delivery-input.bend as Mark
import ./action-output-delivery-loop.bend as Loop
import ./action-output-continuation.bend as Queue
import ./held-opened-state.bend as Construct

type View is Data:
  Flags{depth: Nat,running: Bool,halted: Bool}

def observe(+w: R.World) -> View:
  Flags{R.World.actionDepth(w),R.World.running(w),R.World.halted(w)}

def enter(view: View) -> View:
  match view:
    case Flags{depth,running,halted}: Flags{1n+depth,running,halted}

def exit(view: View) -> View:
  match view:
    case Flags{depth,running,halted}: Flags{Nat.sub(depth,1n),running,halted}

def depth(view: View) -> Nat:
  match view:
    case Flags{depth,running,halted}: depth

def running(view: View) -> Bool:
  match view:
    case Flags{depth,running,halted}: running

def halted(view: View) -> Bool:
  match view:
    case Flags{depth,running,halted}: halted

def output(+w: R.World) -> {observe(Output.outer(w)) == observe(w) : View}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      {==}


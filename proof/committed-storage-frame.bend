# A pure committed-storage/application observation. This is not an accessor
# read: a real reader can pull, mark and choose pending data by posture.
import Base
import ../representation/records.bend as R
import ../representation/base.bend as B

type View is Data:
  View{values: List<&2, R.Value>, tree: List<&2, R.TreeNode>, events: List<&2, R.TraceEvent>}

def values(nodes: List<&2, R.Node>) -> List<&2, R.Value>:
  match nodes:
    case Nil{}: []
    case node <> rest: R.Node.value(node) <> values(rest)

def observe(+w: R.World) -> View:
  View{values(R.World.nodes(w)), R.World.tree(w), R.World.events(w)}

def setValues(+nodes: List<&2, R.Node>, +id: Nat, +next: R.Node,
  same: {R.Node.value(next) == R.Node.value(B.get(R.Node, nodes, id, B.blank_node())) : R.Value}) ->
  {values(List.set(&2, R.Node, nodes, id, next)) == values(nodes) : List<&2, R.Value>}:
  match nodes id:
    case Nil{} n: {==}
    case first <> +rest 0n:
      Equal.cong(R.Value, List<&2, R.Value>, value => value <> values(rest), R.Node.value(next), R.Node.value(first), same)
    case +first <> +rest 1n+previous:
      Equal.cong(List<&2, R.Value>, List<&2, R.Value>, result => R.Node.value(first) <> result, values(List.set(&2, R.Node, rest, previous, next)), values(rest), setValues(rest, previous, next, same))

def store(+w: R.World, +id: Nat, +next: R.Node,
  same: {R.Node.value(next) == R.Node.value(B.node(w, id)) : R.Value}) ->
  {observe(B.store_node(w, id, next)) == observe(w) : View}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      Equal.cong(List<&2, R.Value>, View, values => View{values, tree, events}, values(List.set(&2, R.Node, nodes, id, next)), values(nodes), setValues(nodes, id, next, same))


def valueConfig(+node: R.Node, next: U32) ->
  {R.Node.value(R.Node.with_config(node, next)) == R.Node.value(node) : R.Value}:
  match node:
    case R.Node{+n_kind, +n_value, +n_pending, +n_equals, +n_config, +n_flags, +n_status, +n_time, +n_notified, +n_deps, +n_depsTail, +n_depGen, +n_subs, +n_subsTail, +n_height, +n_nextHeap, +n_prevHeap, +n_parent, +n_firstChild, +n_nextSibling, +n_prevSibling, +n_expr, +n_modified, +n_prevValue, +n_target, +n_loading, +n_x, +n_parentComputed, +n_scope, +n_childCount, +n_disposal, +n_cleanup, +n_effectProgram, +n_returnedCleanup, +n_errorProgram}:
      {==}


def config(+w: R.World, +id: Nat, +next: U32) ->
  {observe(B.store_node(w, id, R.Node.with_config(B.node(w, id), next))) == observe(w) : View}:
  store(w, id, R.Node.with_config(B.node(w, id), next), valueConfig(B.node(w, id), next))



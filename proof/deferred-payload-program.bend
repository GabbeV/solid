def staging(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {W.stageResolved(cutOrigin(initial, next), 3n, Payload.value(next)) == cutScheduled(initial, next) : R.World}:
  Equal.trans(R.World, W.stageResolved(cutOrigin(initial, next), 3n, Payload.value(next)), B.schedule(W.insertSubs(cutSlot(initial, next), 3n)), cutScheduled(initial, next),
    SetterCuts.staged_to_slot(cutOrigin(initial, next), 3n, Payload.value(next), cutSlot(initial, next), {==}, slotPrefix(initial, next), {==}, {==}),
    Equal.trans(R.World, B.schedule(W.insertSubs(cutSlot(initial, next), 3n)), B.schedule(cutInserted(initial, next)), cutScheduled(initial, next),

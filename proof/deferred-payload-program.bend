# Algebraic source-setter cuts reuse the checked general setter lemmas. These
# do not replace its implementation or change the program's input/budget domain.
def slotPrefix(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {SetterCuts.noSlot(cutOrigin(initial, next), 3n, Payload.value(next)) == cutSlot(initial, next) : R.World}:
  {==}

def stamp(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {B.store_node(cutSlot(initial, next), 3n, R.Node.with_notified(B.node(cutSlot(initial, next), 3n), R.Stamped{R.World.epoch(cutSlot(initial, next))})) == cutStamped(initial, next) : R.World}:
  {==}

def notifyAt(+w: R.World) -> R.World:
  W.insert_subs(B.budget(w), w, R.Node.subs(B.node(w, 3n)))

def oneEdge(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {notifyAt(cutStamped(initial, next)) == H.enqueueSub(cutStamped(initial, next), 4n) : R.World}:
  {==}

def heapMinimum(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {R.World.with_minimum(cutStamped(initial, next), Nat.min(R.World.minimum(cutStamped(initial, next)), R.Node.height(B.node(cutStamped(initial, next), 4n)))) == cutStamped(initial, next) : R.World}:
  {==}

def heapFlags(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {B.store_node(cutStamped(initial, next), 4n, R.Node.with_flags(B.node(cutStamped(initial, next), 4n), 8)) == cutFlagged(initial, next) : R.World}:
  {==}

def heapSelected(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {HeapCuts.insertAt(cutStamped(initial, next), 4n, 0) == H.actualInsertIntoHeap(cutFlagged(initial, next), 4n) : R.World}:
  {==}

def heapTail(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {HeapCuts.actualTail(cutFlagged(initial, next), 4n, 0n) == cutInserted(initial, next) : R.World}:
  {==}

def heapActual(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {H.actualInsertIntoHeap(cutFlagged(initial, next), 4n) == cutInserted(initial, next) : R.World}:
  Equal.trans(R.World, H.actualInsertIntoHeap(cutFlagged(initial, next), 4n), HeapCuts.actualTail(cutFlagged(initial, next), 4n, 0n), cutInserted(initial, next),
    HeapCuts.actualCut(cutFlagged(initial, next), 4n, cutFlagged(initial, next), 0n, {==}, {==}), heapTail(initial, next))

def heapInsert(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {H.enqueueSub(cutStamped(initial, next), 4n) == cutInserted(initial, next) : R.World}:
  Equal.trans(R.World, H.enqueueSub(cutStamped(initial, next), 4n), H.insertIntoHeap(cutStamped(initial, next), 4n), cutInserted(initial, next),
    HeapCuts.enqueueAt(cutStamped(initial, next), 4n, cutStamped(initial, next), heapMinimum(initial, next)),
    Equal.trans(R.World, H.insertIntoHeap(cutStamped(initial, next), 4n), HeapCuts.insertAt(cutStamped(initial, next), 4n, 0), cutInserted(initial, next),
      HeapCuts.insertFlags(cutStamped(initial, next), 4n, 0, {==}),
      Equal.trans(R.World, HeapCuts.insertAt(cutStamped(initial, next), 4n, 0), H.actualInsertIntoHeap(cutFlagged(initial, next), 4n), cutInserted(initial, next), heapSelected(initial, next), heapActual(initial, next))))

def notify(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {W.insertSubs(cutSlot(initial, next), 3n) == cutInserted(initial, next) : R.World}:
  Equal.trans(R.World, W.insertSubs(cutSlot(initial, next), 3n), notifyAt(cutStamped(initial, next)), cutInserted(initial, next),
    Equal.cong(R.World, R.World, w => notifyAt(w), B.store_node(cutSlot(initial, next), 3n, R.Node.with_notified(B.node(cutSlot(initial, next), 3n), R.Stamped{R.World.epoch(cutSlot(initial, next))})), cutStamped(initial, next), stamp(initial, next)),
    Equal.trans(R.World, notifyAt(cutStamped(initial, next)), H.enqueueSub(cutStamped(initial, next), 4n), cutInserted(initial, next), oneEdge(initial, next), heapInsert(initial, next)))

def schedule(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {B.schedule(cutInserted(initial, next)) == cutScheduled(initial, next) : R.World}:

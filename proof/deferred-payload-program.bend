    Equal.trans(C.Machine, C.step(C.Machine{cutOrigin(initial, next), C.SetSignalResolved{3n, Payload.value(initial)} <> cutRest(initial, next), [Payload.value(next)]}), C.Machine{W.setResolved(cutOrigin(initial, next), 3n, Payload.value(initial), Payload.value(next)), cutRest(initial, next), [Payload.value(next)]}, state_35(initial, next),
      genericSetter(cutOrigin(initial, next), cutRest(initial, next), Payload.value(initial), Payload.value(next), {==}, {==}, {==}),
      Equal.cong(R.World, C.Machine, w => C.Machine{w, cutRest(initial, next), [Payload.value(next)]}, W.setResolved(cutOrigin(initial, next), 3n, Payload.value(initial), Payload.value(next)), cutScheduled(initial, next), resolved(initial, next))))


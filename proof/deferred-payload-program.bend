def resolved(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {W.setResolved(cutOrigin(initial, next), 3n, Payload.value(initial), Payload.value(next)) == cutScheduled(initial, next) : R.World}:
  Equal.trans(R.World, W.setResolved(cutOrigin(initial, next), 3n, Payload.value(initial), Payload.value(next)), W.stageResolved(cutOrigin(initial, next), 3n, Payload.value(next)), cutScheduled(initial, next),

def flush_eq(+input: Nat, +extra: Nat) -> {A.flush(Nat.add(95n, extra), C.world(M.state_0(input))) == C.world(M.state_95(input)) : R.World}:
  Cuts.flush_from_shape(Nat.add(95n, extra), C.world(M.state_0(input)), M.state_0(input), M.state_95(input), {==}, {==},
    Existing.retimed(M.state_0(input), M.state_95(input), witness(input), extra, Nat.add(95n, extra), {==}))

def observation(+a: R.World, +b: R.World, reached: {a == b : R.World}) -> {Chain.view(a) == Chain.view(b) : Chain.View}:
  Equal.cong(R.World, Chain.View, w => Chain.view(w), a, b, reached)

def completed(+input: Nat, +extra: Nat) -> {Chain.view(A.flush(Nat.add(95n, extra), C.world(M.state_0(input)))) == Chain.expected(input) : Chain.View}:
  observation(A.flush(Nat.add(95n, extra), C.world(M.state_0(input))), C.world(M.state_95(input)), flush_eq(input, extra))

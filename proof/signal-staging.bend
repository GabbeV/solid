  {==}

def step_18(+initial: Nat, +next: Nat) -> {C.step(state_18(initial, next)) == state_19(initial, next) : C.Machine}:
  {==}

def witness(+initial: Nat, +next: Nat) -> P.Path<state_0(initial, next), state_19(initial, next)>:
  P.PathStep{state_1(initial, next), step_0(initial, next), P.PathStep{state_2(initial, next), step_1(initial, next), P.PathStep{state_3(initial, next), step_2(initial, next), P.PathStep{state_4(initial, next), step_3(initial, next), P.PathStep{state_5(initial, next), step_4(initial, next), P.PathStep{state_6(initial, next), step_5(initial, next), P.PathStep{state_7(initial, next), step_6(initial, next), P.PathStep{state_8(initial, next), step_7(initial, next), P.PathStep{state_9(initial, next), step_8(initial, next), P.PathStep{state_10(initial, next), step_9(initial, next), P.PathStep{state_11(initial, next), step_10(initial, next), P.PathStep{state_12(initial, next), step_11(initial, next), P.PathStep{state_13(initial, next), step_12(initial, next), P.PathStep{state_14(initial, next), step_13(initial, next), P.PathStep{state_15(initial, next), step_14(initial, next), P.PathStep{state_16(initial, next), step_15(initial, next), P.PathStep{state_17(initial, next), step_16(initial, next), P.PathStep{state_18(initial, next), step_17(initial, next), P.PathStep{state_19(initial, next), step_18(initial, next), P.PathEnd{R.World{[R.Node{R.Invalid{}, R.Undefined{}, R.Empty{}, True{}, 0, 0, 0, 0n, R.Unstamped{}, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, R.Literal{R.Undefined{}}, False{}, R.Undefined{}, 0n, False{}, 0n, 0n, 0n, 0n, R.NoDisposal{}, 0n, 0n, 0n, 0n}, R.Node{R.Root{}, R.Undefined{}, R.Empty{}, True{}, 0, 0, 0, 0n, R.Unstamped{}, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, R.Literal{R.Undefined{}}, False{}, R.Undefined{}, 0n, False{}, 0n, 0n, 0n, 0n, R.NoDisposal{}, 0n, 0n, 0n, 0n}, R.Node{R.Signal{}, R.Number{next}, R.Empty{}, False{}, 0, 0, 0, 0n, R.Stamped{0n}, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, R.Literal{R.Undefined{}}, False{}, R.Undefined{}, 0n, False{}, 0n, 0n, 0n, 0n, R.NoDisposal{}, 0n, 0n, 0n, 0n}], [R.Link{0n, 0n, 0n, 0n, 0n, 0n}], [0n], 1n, 0n, False{}, [], [], [], [], 0n, False{}, False{}, False{}, 1n, 0n, [R.TreeNode{0n, [], R.Undefined{}}, R.TreeNode{0n, [], R.Undefined{}}], [], R.Healthy{}, False{}, [], [R.NodeExtension{R.FlightEmpty{}, 0n, R.Undefined{}, R.Empty{}, 0n, 0n, R.NoSnapshotValue{}, 0n, R.NoDisposal{}, 0n, False{}, R.Empty{}, R.Unstamped{}, R.QuestionZero{}, R.Empty{}, 0n, R.Undefined{}}], [R.CleanupProgram{[], False{}, 0n}], [], 0n, False{}, False{}, [], 0n, [R.Transaction{[], [], [], [], 0n, 0n, False{}, 0n, 0n, False{}, 0n, False{}, False{}, R.NoIds{}}], [], 0n, 0n, 0n, 0n, [], R.QuestionZero{}, [[]], [R.AsyncObject{False{}, R.Unresolved{}, [], 0n}], [R.AsyncObserver{0n, 0n, False{}, False{}, False{}, R.Undefined{}, R.Undefined{}, 0n}], [R.FlushJob{}], 0n, [R.StreamPlan{[], False{}, R.Empty{}, 0n, 0n, R.Empty{}, R.FromNone{}}], [R.ExternalIterator{0n, 0n, 0n}], [R.StreamState{0n, 0n, 0n, False{}, False{}, False{}, R.Undefined{}, 0n}], [], [R.Awaiter{R.Literal{R.Undefined{}}, False{}, 0n, 0n, 0n, 0n, R.Unresolved{}, False{}, 0n, False{}, False{}, 0n}], False{}, False{}, R.QuestionZero{}, [R.AbortInput{False{}, R.Undefined{}}], [R.ContextKey{R.Undefined{}, R.Empty{}}], [R.ContextRecord{[]}], 0n, [[]], False{}, [R.Literal{R.Undefined{}}], [], [], 0n, [], [], [], [], [], 0n, R.LaneState{[], [[]], [], [], 0n, R.MountUnset{}, [], False{}, False{}, [], [], False{}}, R.VerdictState{False{}, False{}, False{}, False{}}, R.Empty{}, [], R.DeferredArena{[R.DeferredBinding{R.DeferredCell{0n, R.Null{}, False{}, False{}}, 0n}], [], [], [R.DeferredIterator{0n, 0n, 0n, False{}}]}}, [], {==}, {==}}}}}}}}}}}}}}}}}}}}}

def input(+initial: Nat, +next: Nat) -> R.World:
  Driver.staged(initial, next)

def input_eq(+initial: Nat, +next: Nat) -> {input(initial, next) == C.world(state_0(initial, next)) : R.World}:
  {==}

def flush_eq(+initial: Nat, +next: Nat) -> {A.flush(64n, C.world(state_0(initial, next))) == C.world(state_19(initial, next)) : R.World}:
  Cuts.flush_from_shape(64n, C.world(state_0(initial, next)), state_0(initial, next), state_19(initial, next), {==}, {==},
    P.retimed(state_0(initial, next), state_19(initial, next), witness(initial, next), 45n, 64n, {==}))

def flushTransport(-fuel: Nat, -a: R.World, -b: R.World, e: {a == b : R.World}) ->
  {A.flush(fuel, a) == A.flush(fuel, b) : R.World}:
  %e : {A.flush(fuel, a) == A.flush(fuel, _) : R.World}
  {==}

def joinFlush(-fuel: Nat, -a: R.World, -b: R.World, -c: R.World,
  ab: {a == b : R.World}, bc: {A.flush(fuel, b) == c : R.World}) -> {A.flush(fuel, a) == c : R.World}:
  Equal.trans(R.World, A.flush(fuel, a), A.flush(fuel, b), c, flushTransport(fuel, a, b, ab), bc)

def whole_world(+initial: Nat, +next: Nat) -> {A.flush(64n, input(initial, next)) == C.world(state_19(initial, next)) : R.World}:
  joinFlush(64n, input(initial, next), C.world(state_0(initial, next)), C.world(state_19(initial, next)), input_eq(initial, next), flush_eq(initial, next))

def valueTransport(-a: R.World, -b: R.World, e: {a == b : R.World}) ->
  {R.Node.value(B.node(a, 2n)) == R.Node.value(B.node(b, 2n)) : R.Value}:
  %e : {R.Node.value(B.node(a, 2n)) == R.Node.value(B.node(_, 2n)) : R.Value}
  {==}

def readTransport(-fuel: Nat, -a: R.World, -b: R.World, e: {a == b : R.World}) ->
  {A.resultValue(A.read(fuel, a, 2n)) == A.resultValue(A.read(fuel, b, 2n)) : R.Value}:
  %e : {A.resultValue(A.read(fuel, a, 2n)) == A.resultValue(A.read(fuel, _, 2n)) : R.Value}
  {==}

def value_after_commit(+initial: Nat, +next: Nat) -> {R.Node.value(B.node(A.flush(64n, input(initial, next)), 2n)) == R.Number{next} : R.Value}:
  valueTransport(A.flush(64n, input(initial, next)), C.world(state_19(initial, next)), whole_world(initial, next))

def read_before_commit(+initial: Nat, +next: Nat) -> {A.resultValue(A.read(64n, input(initial, next), 2n)) == R.Number{initial} : R.Value}:
  readTransport(64n, input(initial, next), C.world(state_0(initial, next)), input_eq(initial, next))

def read_after_commit(+initial: Nat, +next: Nat) -> {A.resultValue(A.read(64n, A.flush(64n, input(initial, next)), 2n)) == R.Number{next} : R.Value}:
  readTransport(64n, A.flush(64n, input(initial, next)), C.world(state_19(initial, next)), whole_world(initial, next))

def flush_extra(+initial: Nat, +next: Nat, +extra: Nat) -> {A.flush(Nat.add(19n, extra), C.world(state_0(initial, next))) == C.world(state_19(initial, next)) : R.World}:
  Cuts.flush_from_shape(Nat.add(19n, extra), C.world(state_0(initial, next)), state_0(initial, next), state_19(initial, next), {==}, {==},
    P.retimed(state_0(initial, next), state_19(initial, next), witness(initial, next), extra, Nat.add(19n, extra), {==}))

def whole_extra(+initial: Nat, +next: Nat, +extra: Nat) -> {A.flush(Nat.add(19n, extra), input(initial, next)) == C.world(state_19(initial, next)) : R.World}:
  joinFlush(Nat.add(19n, extra), input(initial, next), C.world(state_0(initial, next)), C.world(state_19(initial, next)), input_eq(initial, next), flush_extra(initial, next, extra))

type Outcome is Data:
  Outcome{value: R.Value, pending: R.Slot, intake: List<&2, Nat>, renders: List<&2, Nat>, users: List<&2, R.QueueEntry>, context: Nat, tracking: Bool, running: Bool, scheduled: Bool, stale: Bool, fault: R.Fault}

def outcome(+world: R.World) -> Outcome:
  Outcome{R.Node.value(B.node(world, 2n)), R.Node.pending(B.node(world, 2n)), R.World.pendingNodes(world), R.World.renderQueue(world), R.World.userQueue(world), R.World.context(world), R.World.tracking(world), R.World.running(world), R.World.scheduled(world), R.World.stale(world), R.World.fault(world)}

def expected(next: Nat) -> Outcome:
  Outcome{R.Number{next}, R.Empty{}, [], [], [], 0n, False{}, False{}, False{}, False{}, R.Healthy{}}

def outcomeTransport(-a: R.World, -b: R.World, e: {a == b : R.World}) -> {outcome(a) == outcome(b) : Outcome}:
  %e : {outcome(a) == outcome(_) : Outcome}
  {==}

def complete(+initial: Nat, +next: Nat, +extra: Nat) -> {outcome(A.flush(Nat.add(19n, extra), input(initial, next))) == expected(next) : Outcome}:
  outcomeTransport(A.flush(Nat.add(19n, extra), input(initial, next)), C.world(state_19(initial, next)), whole_extra(initial, next, extra))

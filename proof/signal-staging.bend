def step_11(+initial: Nat, +next: Nat) -> {C.step(state_11(initial, next)) == state_12(initial, next) : C.Machine}:
  {==}

def step_12(+initial: Nat, +next: Nat) -> {C.step(state_12(initial, next)) == state_13(initial, next) : C.Machine}:
  {==}


def stackOf(-actual: C.Machine, -w: R.World, +values: List<&2, R.Value>, run: {actual == C.Machine{w, [], values} : C.Machine}) -> {C.values(actual) == values : List<&2, R.Value>}:
  Equal.cong(C.Machine, List<&2, R.Value>, m => C.values(m), actual, C.Machine{w, [], values}, run)


# Heap/sweep intake observation, independent of transaction and promise state.
# Fault/health are deliberately outside this safety-only footprint.
import Base
import ../representation/records.bend as R
import ../representation/base.bend as B
import ../proof/onflush-registration.bend as Flush
import ../proof/action-output-frame.bend as Output
import ../proof/action-output-delivery-loop.bend as Loop
import ../proof/holding-outer.bend as Hold
import ./masked-projection.bend as Projection

type View is Data:
  HeapEntry{promoted: List<&2,Nat>,dormant: List<&2,Nat>,buckets: List<&2,Nat>,minimum: Nat,maximum: Nat,pending: List<&2,Nat>}

def observe(w: R.World) -> View:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      HeapEntry{promotedWrites,dormantNodes,buckets,minimum,maximum,pendingNodes}

def compose(+before: R.World,+middle: R.World,+after: R.World,last: {observe(after) == observe(middle) : View},first: {observe(middle) == observe(before) : View}) -> {observe(after) == observe(before) : View}:
  Equal.trans(View,observe(after),observe(middle),observe(before),last,first)

def choice(+flag: Bool,+before: R.World,+yes: R.World,+no: R.World,left: {observe(yes) == observe(before) : View},right: {observe(no) == observe(before) : View}) -> {observe(B.choose(~R.World,flag,_=>yes,_=>no)) == observe(before) : View}:
  match flag:
    case True{}: left
    case False{}: right

def pairChoice(+flag: Bool,+before: R.World,+yes: B.Bundle<R.World,Nat>,+no: B.Bundle<R.World,Nat>,left: {observe(B.first(R.World,Nat,yes)) == observe(before) : View},right: {observe(B.first(R.World,Nat,no)) == observe(before) : View}) -> {observe(B.first(R.World,Nat,B.choose(~B.Bundle<R.World,Nat>,flag,_=>yes,_=>no))) == observe(before) : View}:
  match flag:
    case True{}: left
    case False{}: right

def flushMasked(+w: R.World) -> {observe(Flush.outer(w)) == observe(w) : View}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      {==}


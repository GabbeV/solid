# Algebraic source-setter cuts reuse the checked general setter lemmas. These
# do not replace its implementation or change the program's input/budget domain.
def slotPrefix(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {SetterCuts.noSlot(cutOrigin(initial, next), 3n, R.Number{1n}) == cutSlot(initial, next) : R.World}:
  {==}

def stamp(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {B.store_node(cutSlot(initial, next), 3n, R.Node.with_notified(B.node(cutSlot(initial, next), 3n), R.Stamped{R.World.epoch(cutSlot(initial, next))})) == cutStamped(initial, next) : R.World}:
  {==}

def notifyAt(+w: R.World) -> R.World:
  W.insert_subs(B.budget(w), w, R.Node.subs(B.node(w, 3n)))

def oneEdge(+initial: Payload.Ordinary, +next: Payload.Ordinary) -> {notifyAt(cutStamped(initial, next)) == H.enqueueSub(cutStamped(initial, next), 4n) : R.World}:
  {==}


    Equal.trans(C.Machine, C.step(C.Machine{cutOrigin(initial, next), C.SetSignalResolved{3n, R.Number{0n}} <> cutRest(initial, next), [R.Number{1n}]}), C.Machine{W.setResolved(cutOrigin(initial, next), 3n, R.Number{0n}, R.Number{1n}), cutRest(initial, next), [R.Number{1n}]}, state_38(initial, next),

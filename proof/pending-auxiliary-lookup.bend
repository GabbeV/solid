def extensionRoom(+w: R.World, +id: Nat, +record: R.NodeExtension) ->
  {Nat.is_lt(R.Node.x(B.node(B.store_extension(w, id, record), id)), B.length(R.NodeExtension, R.World.extensions(B.store_extension(w, id, record)))) == Nat.is_lt(R.Node.x(B.node(w, id)), B.length(R.NodeExtension, R.World.extensions(w))) : Bool}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      Equal.cong(Nat, Bool, count => Nat.is_lt(R.Node.x(B.node(w, id)), count), B.length(R.NodeExtension, List.set(&2, R.NodeExtension, extensions, R.Node.x(B.node(w, id)), record)), B.length(R.NodeExtension, extensions), Store.lengthSet(R.NodeExtension, extensions, R.Node.x(B.node(w, id)), record))


def newSetOldSlots(+w: R.World, +read: Nat, room: {Nat.is_lt(read, B.length(List<&2, Nat>, R.World.pendingSets(w))) == True{} : Bool}) ->
  {B.pendingSlots(B.first(R.World, Nat, B.newPendingSet(w, [])), read) == B.pendingSlots(w, read) : List<&2, Nat>}:
  match w:
    case R.World{+nodes, +links, +buckets, +minimum, +maximum, +marked, +pendingNodes, +trims, +renderQueue, +userQueue, +context, +tracking, +running, +scheduled, +clock, +epoch, +tree, +events, +fault, +unflushedStaged, +promotedWrites, +extensions, +cleanupPrograms, +dormantNodes, +errorSerial, +halted, +haltNotified, +reports, +callbackEffect, +txArena, +transactions, +flushTransaction, +passTx, +passLane, +judge, +deferredZombies, +question, +pendingSets, +asyncObjects, +asyncObservers, +hostJobs, +syncDepth, +streamPlans, +iterators, +streams, +iteratorEvents, +awaiters, +truthReadHook, +truthConfirmedHook, +questions, +abortInputs, +contextKeys, +contextRecords, +deferredReleases, +releaseLists, +stale, +settledCallbacks, +reactions, +comparators, +actionDepth, +actions, +actionWaits, +arrays, +repeats, +maps, +activeMarks, +laneState, +verdictState, +cleanupError, +ambientMarks, +deferredArena}:
      Append.oldRead(List<&2, Nat>, pendingSets, read, [], [], room)
